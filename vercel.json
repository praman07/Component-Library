{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/components",
      "destination": "/api/components/index"
    },
    {
      "source": "/api/components/(.*)",
      "destination": "/api/components/$1"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth/$1"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin/$1"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
